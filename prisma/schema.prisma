// ML Searcher — schema
// Fluxo: ML API -> Product/PriceHistory -> Offer -> Link -> Click
//        Link pode apontar direto ou passar por uma PresellPage.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- catálogo

/// Categoria/keyword monitorada. O scraper varre uma destas por vez.
model Watch {
  id         String    @id @default(cuid())
  /// Rótulo exibido no painel, ex. "Barbearia"
  label      String
  /// ID de categoria do ML (ex. MLB264787). Nulo quando a busca é só por termo.
  categoryId String?   @unique
  /// Termo de busca livre, usado em /products/search.
  query      String?
  /// Domínio de produto do ML (ex. MLB-RAZOR_BLADES). Quando preenchido,
  /// restringe a busca por termo ao domínio, o que derruba drasticamente o
  /// número de candidatos fora do nicho.
  domainId   String?
  enabled    Boolean   @default(true)
  /// Sobrescreve o desconto mínimo global só para esta watch.
  minDiscount Int?
  /// Teto de produtos por varredura desta categoria.
  limit      Int       @default(100)
  lastRunAt  DateTime?

  /// Categoria pai no ML — permite exibir a árvore no painel.
  parentCategoryId String?
  /// Profundidade na árvore (0 = raiz monitorada). Só para indentar a lista.
  depth      Int       @default(0)
  /// true quando veio da sincronização automática da árvore de categorias;
  /// false quando o usuário criou na mão (e a sincronização não mexe).
  auto       Boolean   @default(false)

  products   Product[]
  phrases    PhraseWatch[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([enabled])
  @@index([parentCategoryId])
}

model Product {
  id            String  @id @default(cuid())
  /// ID do anúncio no Mercado Livre, ex. MLB1234567890. É o anúncio mais
  /// barato do produto de catálogo — é dele que sai o link de afiliado.
  mlId          String  @unique
  /// Produto de catálogo que originou o anúncio, quando a coleta veio pelos
  /// destaques de categoria. Permite reavaliar as ofertas do mesmo produto.
  catalogId     String?
  title         String
  thumbnail     String?
  permalink     String

  /// Preço atual em centavos — evita float em dinheiro.
  price         Int
  /// "De" declarado pelo ML, quando existe. Em centavos.
  originalPrice Int?
  currency      String  @default("BRL")

  categoryId    String?
  categoryName  String?
  sellerId      String?
  sellerName    String?
  /// power_seller / platinum / gold — usado no score.
  sellerStatus  String?

  freeShipping  Boolean @default(false)
  soldQuantity  Int     @default(0)
  available     Int     @default(0)
  condition     String?
  officialStore Boolean @default(false)

  watchId       String?
  watch         Watch?  @relation(fields: [watchId], references: [id], onDelete: SetNull)

  blocked       Boolean @default(false)

  /// true quando o título bate no filtro de palavras que o usuário configurou
  /// (palavra excluída presente, ou nenhuma das palavras obrigatórias presente).
  /// É uma coluna MATERIALIZADA: recalculada de uma vez sempre que a lista de
  /// palavras muda, para as telas filtrarem por um booleano indexado em vez de
  /// rodar expressão regular sobre o título a cada consulta. Nada é apagado:
  /// tirar a palavra recalcula a coluna e o produto volta a aparecer.
  hiddenByWords Boolean @default(false)

  /// null = ainda não verificado no programa de afiliados; true = elegível;
  /// false = rejeitado (o Mercado Livre respondeu "URL not allowed"). Uma vez
  /// false, o produto nunca mais aparece nas ofertas — diferente do
  /// hiddenByWords, aqui NÃO existe caminho de volta automático, porque a
  /// elegibilidade é decidida pelo ML, não por uma configuração do usuário.
  affiliateEligible   Boolean?
  affiliateCheckedAt  DateTime?
  /// Mensagem crua devolvida pelo Mercado Livre quando rejeitado, só para
  /// debug no painel (ex.: "URL not allowed in affiliates program").
  affiliateCheckError String?

  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  history       PriceHistory[]
  offers        Offer[]
  links         Link[]

  @@index([lastSeenAt])
  @@index([categoryId])
  @@index([blocked])
  @@index([catalogId])
  @@index([hiddenByWords])
  @@index([affiliateEligible])
}

/// Um ponto de preço por varredura. É daqui que sai o "mais barato que o normal".
model PriceHistory {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price      Int
  capturedAt DateTime @default(now())

  @@index([productId, capturedAt])
}

enum OfferStatus {
  NEW
  PUBLISHED
  IGNORED
}

/// Uma queda de preço detectada. Só vira Offer o que passou do threshold.
model Offer {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  price         Int
  /// Base de comparação usada: original_price do ML ou a média/mínima do histórico.
  referencePrice Int
  /// Como a referência foi obtida: ML_ORIGINAL | HISTORY_AVG | HISTORY_MIN
  referenceKind String
  discountPct   Int
  /// 0-100. Desconto + reputação + vendas + frete grátis.
  score         Int         @default(0)

  status        OfferStatus @default(NEW)
  runId         String?
  run           ScrapeRun?  @relation(fields: [runId], references: [id], onDelete: SetNull)

  detectedAt    DateTime    @default(now())
  publishedAt   DateTime?
  /// Quando o envio automático pro WhatsApp mandou esta oferta. Independente
  /// de `status`: o envio NUNCA marca como PUBLISHED, só evita reenviar a
  /// mesma oferta num ciclo seguinte.
  whatsappSentAt DateTime?

  @@index([status, detectedAt])
  @@index([score])
  @@index([productId, detectedAt])
  @@index([status, whatsappSentAt])
}

// ------------------------------------------------------------------- links

enum LinkKind {
  /// Vai direto pro Mercado Livre, sem contabilizar clique.
  DIRECT
  /// Passa por /r/{slug} para contar o clique e depois redireciona.
  TRACKED
  /// Passa por /p/{slug} (pre-sell) e de lá para o destino final.
  PRESELL
}

model Link {
  id          String   @id @default(cuid())
  /// Parte final da URL pública: /r/{slug} ou /p/{slug}
  slug        String   @unique
  kind        LinkKind @default(TRACKED)
  label       String?

  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Destino final. URL de afiliado quando houver, senão o permalink do produto.
  targetUrl   String
  /// true quando targetUrl foi montado com a tag de afiliado; false = link cru.
  affiliate   Boolean  @default(false)

  presellId   String?
  presell     Presell? @relation(fields: [presellId], references: [id], onDelete: SetNull)

  clickCount  Int      @default(0)
  active      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clicks      Click[]

  @@index([productId])
  @@index([createdAt])
}

model Click {
  id        String   @id @default(cuid())
  linkId    String
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)

  /// Hash do IP — o suficiente pra deduplicar sem guardar dado pessoal.
  ipHash    String?
  userAgent String?
  referer   String?
  country   String?
  /// mobile | desktop | tablet | bot
  device    String?
  /// Clique repetido do mesmo ipHash em janela curta.
  duplicate Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([linkId, createdAt])
  @@index([createdAt])
}

// ----------------------------------------------------------------- presell

/// Modelo (template) de página de aquecimento. UM modelo serve VÁRIOS
/// produtos: os campos de conteúdo aceitam as variáveis {{titulo}} {{preco}}
/// {{precoAntigo}} {{desconto}} {{imagem}}, e quando ficam vazios o conteúdo
/// sai automaticamente do produto do Link que abriu a página.
model Presell {
  id            String   @id @default(cuid())
  slug          String   @unique
  /// Nome do modelo. Uso interno do painel, o visitante nunca vê.
  title         String
  /// Chamada da página. Vazia = usa o título do produto. Aceita variáveis.
  headline      String?
  /// Texto de apoio, aceita quebras de linha e variáveis.
  body          String?
  ctaText       String   @default("Liberar oferta")

  /// Link intermediário que o visitante abre antes de liberar o destino.
  gateUrl       String?
  gateLabel     String   @default("Acessar link do patrocinador")
  /// Segundos de espera antes de liberar o botão final.
  gateDelay     Int      @default(5)

  /// Imagem fixa. Vazia = usa a foto do produto do link.
  imageUrl      String?
  /// Preço exibido na página, em centavos. Vazio = usa o preço do produto.
  priceLabel    Int?
  originalLabel Int?

  /// Modelo usado quando um link é gerado "com página de aquecimento" sem que
  /// o usuário escolha qual modelo. Só um modelo fica marcado por vez.
  isDefault     Boolean  @default(false)

  active        Boolean  @default(true)
  views         Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  links         Link[]

  @@index([active])
  @@index([isDefault])
}

// -------------------------------------------------- copy: frases/templates

model Phrase {
  id         String   @id @default(cuid())
  text       String
  usageCount Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  /// Categorias monitoradas (Watch) às quais a frase pertence. Lista vazia =
  /// pool geral, usado só por produto sem watch.
  watches    PhraseWatch[]

  @@index([active])
}

/// Vínculo N:N entre frase e categoria monitorada. Apagar qualquer um dos
/// lados só remove o vínculo — a frase sobrevive e, se ficar sem nenhum
/// vínculo, volta pro pool geral (mesma semântica que watchId = null tinha
/// antes desta tabela existir).
model PhraseWatch {
  phraseId String
  watchId  String
  phrase   Phrase @relation(fields: [phraseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  watch    Watch  @relation(fields: [watchId],  references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([phraseId, watchId])
  @@index([watchId])
}

model MessageTemplate {
  id         String   @id @default(cuid())
  name       String
  /// Suporta {{titulo}} {{preco}} {{precoAntigo}} {{desconto}} {{link}} {{frase}}
  body       String
  isDefault  Boolean  @default(false)
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------- whatsapp

model WhatsappInstance {
  id        String   @id @default(cuid())
  name      String
  /// Base URL da Uazapi, ex. https://free.uazapi.com
  host      String
  /// Token da instância. Guardado cifrado na aplicação.
  token     String
  /// connected | disconnected | unknown
  status    String   @default("unknown")
  lastSync  DateTime?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups    WhatsappGroup[]
  sends     SendLog[]
}

model WhatsappGroup {
  id         String   @id @default(cuid())
  instanceId String
  instance   WhatsappInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  /// JID do grupo, ex. 1203630@g.us
  remoteJid  String
  name       String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  sends      SendLog[]

  @@unique([instanceId, remoteJid])
}

model SendLog {
  id         String   @id @default(cuid())
  instanceId String
  instance   WhatsappInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  groupId    String?
  group      WhatsappGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)

  message    String
  linkId     String?
  /// pending | sent | failed
  status     String   @default("pending")
  error      String?
  /// Preenchido quando o envio é agendado para o futuro.
  scheduledFor DateTime?
  sentAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([status, scheduledFor])
  @@index([createdAt])
  @@index([status, sentAt])
}

// ------------------------------------------------------------ execução/cfg

enum RunStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

model ScrapeRun {
  id            String    @id @default(cuid())
  status        RunStatus @default(RUNNING)
  /// manual | cron
  trigger       String    @default("manual")

  watchesTotal  Int       @default(0)
  watchesDone   Int       @default(0)
  itemsSeen     Int       @default(0)
  productsNew   Int       @default(0)
  offersNew     Int       @default(0)

  error         String?
  /// Linhas de log da execução, para exibir no painel.
  log           String?

  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  offers        Offer[]

  @@index([startedAt])
}

/// Configuração editável pelo painel — desconto mínimo, tag de afiliado,
/// domínio público dos links, etc. Tudo em texto, tipado na camada de app.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Token de usuário do Mercado Livre, obtido pelo fluxo authorization_code.
/// A documentação oficial só reconhece authorization_code e refresh_token
/// como grant types; client_credentials funciona por tolerância e pode ser
/// cortado sem aviso, como aconteceu com a API de busca.
///
/// Linha única: o id fixo "default" impede duplicata.
model MLAuth {
  id           String   @id @default("default")
  /// Id e apelido da conta do Mercado Livre que autorizou.
  mlUserId     String?
  nickname     String?

  accessToken  String
  /// O ML rotaciona o refresh token a cada uso: o antigo morre na hora.
  refreshToken String
  expiresAt    DateTime
  scope        String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
