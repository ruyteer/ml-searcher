# Postgres do Railway (Variables -> DATABASE_URL do addon)
DATABASE_URL="postgresql://user:pass@host:5432/railway"

# Senha única do painel. Trocar aqui derruba todas as sessões.
APP_PASSWORD="troque-isto"

# Aplicação criada em developers.mercadolivre.com.br
# Pode ficar vazio: dá pra preencher pelo painel em /configuracoes.
ML_CLIENT_ID=""
ML_CLIENT_SECRET=""

# URL de redirecionamento (Redirect URI) cadastrada na aplicação do Mercado
# Livre. Precisa ser https: o ML nao aceita http nem localhost. Tem que bater
# byte a byte com o que foi cadastrado la.
#
# Em producao o valor natural e https://SEU-DOMINIO/api/ml/callback.
#
# Isto aqui e so um fallback de boot: o valor definitivo fica no banco, na
# tabela Setting com a chave "mlRedirectUri", editavel pelo painel em
# /configuracoes?aba=mercadolivre. Ficou fora do SETTINGS_SCHEMA porque e dado
# do cadastro da aplicacao, nao um ajuste de comportamento do sistema.
ML_REDIRECT_URI=""

# Domínio público usado ao montar os links copiáveis.
# Vazio = usa o host da própria request (a URL do Railway).
PUBLIC_BASE_URL=""

# Fase 6 — Uazapi
UAZAPI_HOST=""

# Protege /api/cron/* quando o scraping rodar agendado.
CRON_SECRET=""

# Salt do hash de IP dos cliques. Gere um valor aleatorio em producao.
IP_HASH_SALT=""
